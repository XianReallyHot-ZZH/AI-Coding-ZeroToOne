#!/bin/bash
# yy-codereview - Code Review CLI Tool
#
# Usage:
#   yy-codereview "review current branch"
#   yy-codereview "review uncommitted changes"
#   yy-codereview                    # interactive mode
#   yy-codereview --server           # start web server

set -e

# Find the JAR file
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
JAR_FILE="$SCRIPT_DIR/codereview-agent-1.0.0-SNAPSHOT.jar"

# If JAR not found in script dir, check target/
if [ ! -f "$JAR_FILE" ]; then
    JAR_FILE="$SCRIPT_DIR/target/codereview-agent-1.0.0-SNAPSHOT.jar"
fi

# Build if JAR doesn't exist
if [ ! -f "$JAR_FILE" ]; then
    echo "Building yy-codereview..."
    cd "$SCRIPT_DIR"
    mvn package -DskipTests -q
    JAR_FILE="$SCRIPT_DIR/target/codereview-agent-1.0.0-SNAPSHOT.jar"
fi

# Check if API key is set
if [ -z "$AI_API_KEY" ] && [ -z "$DEEPSEEK_API_KEY" ] && [ -z "$OPENAI_API_KEY" ]; then
    echo "Warning: No API key found. Please set one of:"
    echo "  export AI_API_KEY=your-key"
    echo "  export DEEPSEEK_API_KEY=your-key"
    echo "  export OPENAI_API_KEY=your-key"
    echo ""
fi

# Run the CLI
exec java -jar "$JAR_FILE" "$@"
